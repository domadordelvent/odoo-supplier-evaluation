<odoo>
    <record id="purchase_order_form_supplier_deadlines" model="ir.ui.view">
        <field name="name">purchase.order.form.supplier.deadlines</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="after">
                <button name="action_open_supplier_deadline_history" type="object" icon="fa-calendar" title="Historial de terminis" groups="purchase.group_purchase_user" invisible="not id or display_type"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='date_planned']" position="after">
                <button name="action_open_supplier_deadline_history" type="object" string="Historial de terminis" icon="fa-calendar" groups="purchase.group_purchase_user" invisible="not id or display_type"/>
            </xpath>
        </field>
    </record>
</odoo>
