<odoo>
    <record id="view_deadline_renegotiation_wizard_form" model="ir.ui.view">
        <field name="name">supplier.deadline.renegotiation.wizard.form</field>
        <field name="model">supplier.evaluation.deadline.renegotiation.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirmar renegociació de termini">
                <div class="alert alert-info" role="alert">
                    Confirmar una renegociació no elimina el compromís original.
                    L'historial i les avaluacions de recepcions completades es conserven.
                </div>
                <group>
                    <field name="revision_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="original_date_known" invisible="1"/>
                    <field name="order_id" string="Comanda" options="{'no_open': True}"/>
                    <field name="purchase_line_id" string="Línia" options="{'no_open': True}"/>
                    <field name="original_date" string="Compromís original conservat" invisible="not original_date_known"/>
                    <field name="previous_agreed_date" string="Data anterior acceptada"/>
                    <field name="new_agreed_date" string="Nova data proposada"/>
                </group>
                <group>
                    <field name="justification" required="1" placeholder="Descriu l'acord i la referència de la comunicació amb el proveïdor"/>
                    <field name="supplier_attributable" widget="radio" required="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirmar renegociació" class="btn-primary" groups="purchase.group_purchase_manager"/>
                    <button string="Cancel·lar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
